# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf
*.glb filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text

# Small generated sounds live in regular Git (pushable from anywhere).
# Big assets still use LFS via the rules above.
sounds/*.wav !filter !diff !merge binary
# Third-party add-ons are stored as-is in regular Git.
addons/**/*.png !filter !diff !merge binary
weapons/models/*.glb !filter !diff !merge binary
